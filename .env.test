# Test Environment Variables
# Used for running tests without affecting development or production databases

# Database
DATABASE_URL=postgresql://test:test@localhost:5432/deskmain_test

# Authentication
JWT_SECRET=test-secret-key-for-testing-only
JWT_EXPIRY=7d
JWT_REFRESH_EXPIRY=30d

# Server
PORT=5001
API_URL=http://localhost:5001
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (more relaxed for testing)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=1000

# Email (mock)
SENDGRID_API_KEY=test-key-do-not-use
SENDGRID_FROM_EMAIL=test@deskmain.com

# AWS S3 (local mock)
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=deskmain-test

# Google OAuth (test credentials)
GOOGLE_CLIENT_ID=test-client-id
GOOGLE_CLIENT_SECRET=test-client-secret

# File Upload
MAX_FILE_SIZE=50000000
UPLOAD_DIR=./uploads
STORAGE_PATH=./storage

# Logging
LOG_LEVEL=error
LOG_FILE=logs/test.log

# Node Environment
NODE_ENV=test

# Testing
TEST_MODE=true
TEST_TIMEOUT=10000
