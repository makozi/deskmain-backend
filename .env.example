# Server Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deskmain
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deskmain

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRE=30d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@deskmain.com

# Payment Providers
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST_xxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_xxx
PAYONEER_API_KEY=your_payoneer_api_key
WISE_API_TOKEN=your_wise_api_token
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# AWS S3 (Optional - for future use)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=xxx

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./storage
LOGO_DIR=./storage/logos
PRODUCT_FILE_DIR=./storage/product_files

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Features
ENABLE_AFFILIATE=true
ENABLE_MARKETPLACE=true
ENABLE_COURSES=true
ENABLE_PHYSICAL_PRODUCTS=true
ENABLE_AI_FEATURES=false

# KYC Configuration
KYC_VERIFICATION_ENABLED=true
KYC_SELFIE_REQUIRED=true
