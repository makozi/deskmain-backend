# DeskMain Backend - Production Environment Configuration
# Copy this file to production.env and fill in your values
# ⚠️ NEVER commit actual production values to version control

# Node Environment
NODE_ENV=production
DEBUG=false

# Server Configuration
PORT=5000
HOST=0.0.0.0
BASE_URL=https://api.deskmain.com

# Database Configuration
DB_HOST=deskmain-prod-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=deskmain_production
DB_USER=postgres@deskmain-prod-postgres
DB_PASSWORD=your-ultra-strong-production-password-minimum-32-chars
DB_POOL_MIN=10
DB_POOL_MAX=30
DB_TIMEOUT=30000
DB_SSL=true
DB_REPLICATION_ENABLED=true

# Redis Configuration (Production cluster)
REDIS_HOST=deskmain-prod-redis.redis.cache.windows.net
REDIS_PORT=6379
REDIS_PASSWORD=your-ultra-strong-redis-production-password
REDIS_DB=0
REDIS_CACHE_TTL=14400
REDIS_CLUSTER_ENABLED=true

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-ultra-secure-random-string
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-production-refresh-secret-ultra-secure-random-string
JWT_REFRESH_EXPIRE=30d

# Email Configuration
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-production-api-key
SENDGRID_FROM_EMAIL=noreply@deskmain.com
SENDGRID_FROM_NAME=DeskMain

# AWS S3 Configuration (Production bucket)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-production-aws-access-key
AWS_SECRET_ACCESS_KEY=your-production-aws-secret-key
AWS_S3_BUCKET=deskmain-production-bucket
AWS_S3_ACL=private
MAX_FILE_SIZE=52428800
AWS_CLOUDFRONT_DOMAIN=d123456.cloudfront.net

# OAuth Providers (Production apps)
GOOGLE_OAUTH_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://app.deskmain.com/auth/google/callback

GITHUB_OAUTH_CLIENT_ID=your-production-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-production-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=https://app.deskmain.com/auth/github/callback

FACEBOOK_OAUTH_CLIENT_ID=your-production-facebook-client-id
FACEBOOK_OAUTH_CLIENT_SECRET=your-production-facebook-client-secret
FACEBOOK_OAUTH_REDIRECT_URI=https://app.deskmain.com/auth/facebook/callback

APPLE_OAUTH_CLIENT_ID=your-production-apple-client-id
APPLE_OAUTH_KEY_ID=your-production-apple-key-id
APPLE_OAUTH_TEAM_ID=your-production-apple-team-id
APPLE_OAUTH_REDIRECT_URI=https://app.deskmain.com/auth/apple/callback

# Payment Gateway (Production keys)
STRIPE_SECRET_KEY=sk_live_your-production-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-production-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_live_your-production-webhook-secret

PAYPAL_CLIENT_ID=your-production-paypal-client-id
PAYPAL_CLIENT_SECRET=your-production-paypal-client-secret
PAYPAL_MODE=live

# SMS Configuration (Production)
TWILIO_ACCOUNT_SID=your-production-twilio-account-sid
TWILIO_AUTH_TOKEN=your-production-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_DIR=/var/log/deskmain-api
LOG_RETENTION_DAYS=30

# Session Configuration
SESSION_SECRET=your-production-session-secret-ultra-secure-random-string
SESSION_TIMEOUT=3600000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# CORS Configuration
CORS_ORIGINS=https://app.deskmain.com,https://admin.deskmain.com,https://merchant.deskmain.com
CORS_CREDENTIALS=true

# Security Headers
HSTS_MAX_AGE=31536000
CSP_DIRECTIVES=default-src 'self';script-src 'self' cdn.example.com;style-src 'self' 'unsafe-inline'

# Feature Flags
FEATURE_WEBHOOKS=true
FEATURE_AFFILIATE_PROGRAM=true
FEATURE_COURSES=true
FEATURE_EMAIL_CAMPAIGNS=true

# Monitoring & Analytics
SENTRY_DSN=your-sentry-production-dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACE_SAMPLE_RATE=0.1
SENTRY_ERROR_SAMPLE_RATE=1.0

# New Relic (APM)
NEW_RELIC_LICENSE_KEY=your-new-relic-production-license-key
NEW_RELIC_APP_NAME=DeskMain-Production-API

# DataDog (Optional alternative/additional monitoring)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# Mobile App Configuration
MOBILE_API_VERSION=v1
MOBILE_APP_MIN_VERSION=1.0.0
MOBILE_APP_LATEST_VERSION=1.5.0

# APK/IPA Signing
IOS_CERTIFICATE_PATH=/etc/ssl/deskmain/production/ios.p12
ANDROID_KEYSTORE_PATH=/etc/ssl/deskmain/production/android.keystore

# Database Backup Configuration
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_S3_BUCKET=deskmain-prod-backups

# CDN Configuration
CDN_ENABLED=true
CDN_PROVIDER=cloudflare
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Email Service (Backup/Fallback)
BACKUP_EMAIL_SERVICE=mailgun
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=email.deskmain.com

# IP Whitelist (Optional)
ADMIN_IP_WHITELIST=192.168.1.1,203.0.113.0/24

# Encryption Keys (For sensitive data)
ENCRYPTION_KEY=your-production-encryption-key-32-chars-min
ENCRYPTION_ALGORITHM=aes-256-gcm

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please check back soon.
