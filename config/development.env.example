# DeskMain Backend - Development Environment Configuration
# Copy this file to development.env and fill in your values

# Node Environment
NODE_ENV=development
DEBUG=true

# Server Configuration
PORT=5000
HOST=localhost
BASE_URL=http://localhost:5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=deskmain_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=3600

# JWT Configuration
JWT_SECRET=your-development-secret-key-change-this
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-development-refresh-secret-key
JWT_REFRESH_EXPIRE=30d

# Email Configuration
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@deskmain-dev.com
SENDGRID_FROM_NAME=DeskMain Dev

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=deskmain-dev-bucket
AWS_S3_ACL=private
MAX_FILE_SIZE=52428800

# OAuth Providers
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

GITHUB_OAUTH_CLIENT_ID=your-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/auth/github/callback

FACEBOOK_OAUTH_CLIENT_ID=your-facebook-client-id
FACEBOOK_OAUTH_CLIENT_SECRET=your-facebook-client-secret
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:3000/auth/facebook/callback

APPLE_OAUTH_CLIENT_ID=your-apple-client-id
APPLE_OAUTH_KEY_ID=your-apple-key-id
APPLE_OAUTH_TEAM_ID=your-apple-team-id
APPLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/apple/callback

# Payment Gateway
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-webhook-secret

PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_DIR=./logs

# Session Configuration
SESSION_SECRET=your-session-secret-key
SESSION_TIMEOUT=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Feature Flags
FEATURE_WEBHOOKS=true
FEATURE_AFFILIATE_PROGRAM=true
FEATURE_COURSES=true
FEATURE_EMAIL_CAMPAIGNS=true

# Mobile App Configuration
MOBILE_API_VERSION=v1
MOBILE_APP_MIN_VERSION=1.0.0
