# DeskMain Backend - Staging Environment Configuration
# Copy this file to staging.env and fill in your values

# Node Environment
NODE_ENV=staging
DEBUG=false

# Server Configuration
PORT=5000
HOST=0.0.0.0
BASE_URL=https://staging-api.deskmain.com

# Database Configuration
DB_HOST=staging-postgres.database.azure.com
DB_PORT=5432
DB_NAME=deskmain_staging
DB_USER=postgres@staging-postgres
DB_PASSWORD=your-strong-staging-password
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_TIMEOUT=30000
DB_SSL=true

# Redis Configuration
DB_CACHE_HOST=staging-redis.redis.cache.windows.net
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-staging-password
REDIS_DB=0
REDIS_CACHE_TTL=7200

# JWT Configuration
JWT_SECRET=your-staging-jwt-secret-keep-this-secure
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-staging-refresh-secret
JWT_REFRESH_EXPIRE=30d

# Email Configuration
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your-sendgrid-staging-api-key
SENDGRID_FROM_EMAIL=noreply@staging.deskmain.com
SENDGRID_FROM_NAME=DeskMain Staging

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-staging-aws-access-key
AWS_SECRET_ACCESS_KEY=your-staging-aws-secret-key
AWS_S3_BUCKET=deskmain-staging-bucket
AWS_S3_ACL=private
MAX_FILE_SIZE=52428800

# OAuth Providers (Staging apps)
GOOGLE_OAUTH_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-staging-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://staging-app.deskmain.com/auth/google/callback

GITHUB_OAUTH_CLIENT_ID=your-staging-github-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-staging-github-client-secret
GITHUB_OAUTH_REDIRECT_URI=https://staging-app.deskmain.com/auth/github/callback

FACEBOOK_OAUTH_CLIENT_ID=your-staging-facebook-client-id
FACEBOOK_OAUTH_CLIENT_SECRET=your-staging-facebook-client-secret
FACEBOOK_OAUTH_REDIRECT_URI=https://staging-app.deskmain.com/auth/facebook/callback

APPLE_OAUTH_CLIENT_ID=your-staging-apple-client-id
APPLE_OAUTH_KEY_ID=your-staging-apple-key-id
APPLE_OAUTH_TEAM_ID=your-staging-apple-team-id
APPLE_OAUTH_REDIRECT_URI=https://staging-app.deskmain.com/auth/apple/callback

# Payment Gateway (Staging/Test Keys)
STRIPE_SECRET_KEY=sk_test_your-stripe-staging-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-staging-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_test_your-staging-webhook-secret

PAYPAL_CLIENT_ID=your-paypal-staging-client-id
PAYPAL_CLIENT_SECRET=your-paypal-staging-client-secret
PAYPAL_MODE=sandbox

# SMS Configuration (Staging)
TWILIO_ACCOUNT_SID=your-staging-twilio-account-sid
TWILIO_AUTH_TOKEN=your-staging-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=/var/log/deskmain-api

# Session Configuration
SESSION_SECRET=your-staging-session-secret-keep-secure
SESSION_TIMEOUT=86400000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# CORS Configuration
CORS_ORIGINS=https://staging-app.deskmain.com,https://staging-admin.deskmain.com
CORS_CREDENTIALS=true

# Feature Flags
FEATURE_WEBHOOKS=true
FEATURE_AFFILIATE_PROGRAM=true
FEATURE_COURSES=true
FEATURE_EMAIL_CAMPAIGNS=true

# Monitoring & Analytics
SENTRY_DSN=your-sentry-staging-dsn
SENTRY_ENVIRONMENT=staging
SENTRY_TRACE_SAMPLE_RATE=0.5

# New Relic (Optional)
NEW_RELIC_LICENSE_KEY=your-new-relic-staging-license-key
NEW_RELIC_APP_NAME=DeskMain-Staging-API

# Mobile App Configuration
MOBILE_API_VERSION=v1
MOBILE_APP_MIN_VERSION=1.0.0

# APK/IPA Signing (if applicable)
IOS_CERTIFICATE_PATH=/etc/ssl/deskmain/ios.p12
ANDROID_KEYSTORE_PATH=/etc/ssl/deskmain/android.keystore
